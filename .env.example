# Copy to .env and replace every CHANGE_ME. `scripts/gen-env.sh` does this for you.
# Never commit .env. scripts/setup.sh adds a block of settings from setup.yml at the end.
#
# Attach mode (production LiteLLM): LITELLM_MASTER_KEY = the production master key or a proxy-admin
# key, and add DB_ADMIN_PASSWORD (password of setup.yml database.admin_user).

# Pin a version for production, e.g. ghcr.io/berriai/litellm:v1.xx.x-stable
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
# never = only use images already on this machine (default). missing = pull what is absent.
PULL_POLICY=never

# LiteLLM (master key must start with sk-)
LITELLM_MASTER_KEY=sk-CHANGE_ME
LITELLM_SALT_KEY=sk-CHANGE_ME
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=CHANGE_ME

# Provider keys (only the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=

# Postgres
POSTGRES_PASSWORD=CHANGE_ME
LITELLM_DB_PASSWORD=CHANGE_ME
LANGFUSE_DB_PASSWORD=CHANGE_ME
GRAFANA_RO_DB_PASSWORD=CHANGE_ME
# host:port Grafana uses for cost reports - point at a read replica in production
GRAFANA_PG_HOST=postgres-replica:5432

# Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Langfuse (keys are pre-created on first boot, then used by the proxy)
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_ADMIN_EMAIL=admin@example.com
LANGFUSE_ADMIN_PASSWORD=CHANGE_ME
LANGFUSE_SALT=CHANGE_ME
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME
# exactly 64 hex chars (openssl rand -hex 32)
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# Langfuse blob store (only for --profile traces). Leave ENDPOINT/keys empty to use the
# bundled local-s3 service, which stores files on a local Docker volume.
LANGFUSE_S3_ENDPOINT=
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_REGION=auto
LANGFUSE_S3_ACCESS_KEY_ID=
LANGFUSE_S3_SECRET_ACCESS_KEY=
LANGFUSE_S3_FORCE_PATH_STYLE=true

# Host ports (all bound to 127.0.0.1). Change if something else already uses them.
LITELLM_PORT=4000          # first LiteLLM instance
LITELLM_PORT_LAST=4001     # last port of the range (one per instance)
LANGFUSE_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
# (Postgres has no host port: internal network only)

# Streaming replica of the gateway DB (postgres-replica, read by Grafana)
REPLICATION_PASSWORD=

# Redis shared by the LiteLLM instances (service litellm-redis)
LITELLM_REDIS_PASSWORD=

# Number of LiteLLM instances (they share litellm-redis). Host ports LITELLM_PORT..LITELLM_PORT_LAST.
LITELLM_REPLICAS=2
# Where people open Langfuse (used in Grafana's "open session" links)
LANGFUSE_PUBLIC_URL=http://localhost:3000
# Local test viewers per team/org in Grafana + Langfuse (apply-tenants.sh). Set false in production.
CREATE_TEST_USERS=true
