# .env - EVERY credential of the gateway, in one place. Git-ignored: never commit it.
#
# The runner copies this file to .env on the first run, fills every EMPTY value marked (auto)
# with a random one, and appends a key for every team key in config/teams.yaml. Values you set
# are never changed. Comments go on their own line (no "value  # comment").
#
# (fixed) = do not change after the first start: it is baked into a database.

# ================================================================ LLM providers
# Models in config/models.yaml are added to LiteLLM only for the providers set here.
# Groq       https://console.groq.com/keys          -> gpt-oss-120b, gpt-oss-20b, qwen3.8-27b
GROQ_API_KEY=
# Gemini     https://aistudio.google.com/apikey     -> gemini-3.6-flash, gemini-embedding-001
GEMINI_API_KEY=
# OpenRouter https://openrouter.ai/settings/keys    -> fallback for gpt-oss-120b / gpt-oss-20b
OPENROUTER_API_KEY=

# ================================================================ people (admin logins)
# LiteLLM admin UI  http://localhost:4000/ui
LITELLM_UI_USERNAME=admin
# (auto)
LITELLM_UI_PASSWORD=
# Admin API key (Authorization: Bearer ...). Must start with sk-. (auto)
LITELLM_MASTER_KEY=

# Grafana  http://localhost:3001
GRAFANA_ADMIN_USER=admin
# (auto)
GRAFANA_ADMIN_PASSWORD=

# Langfuse  http://localhost:3000. Created on the first start; the runner also signs in with it to
# create the team projects, so if you change the password in the Langfuse UI, change it here too.
LANGFUSE_ADMIN_EMAIL=admin@example.com
LANGFUSE_ADMIN_NAME=admin
# (auto) at least 8 characters
LANGFUSE_ADMIN_PASSWORD=

# ================================================================ service secrets (machines)
# Encrypts provider credentials stored in the LiteLLM DB. (auto, fixed)
LITELLM_SALT_KEY=
# Default Langfuse project keys (traffic without a team, e.g. admin calls). (auto, fixed)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Postgres superuser of both databases. (auto, fixed)
POSTGRES_PASSWORD=
# LiteLLM's own database user. (auto, fixed)
LITELLM_DB_PASSWORD=
# Read-only user Grafana reads the reporting views with. (auto)
GRAFANA_RO_DB_PASSWORD=
# State Redis (limits, budgets, cooldowns, spend buffer) and cache Redis. (auto)
REDIS_STATE_PASSWORD=
REDIS_CACHE_PASSWORD=

# Langfuse internals. (auto, fixed)
LANGFUSE_DB_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
CLICKHOUSE_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
# 64 hex characters (auto, fixed)
LANGFUSE_ENCRYPTION_KEY=
LOCAL_S3_ACCESS_KEY=
LOCAL_S3_SECRET_KEY=

# ================================================================ team keys (config/teams.yaml)
# One line per team key: KEY_<TEAM>_<KEY>=sk-...  Added automatically for new keys; hand each
# value to the app that uses it. Change a value + re-run to rotate that key.
