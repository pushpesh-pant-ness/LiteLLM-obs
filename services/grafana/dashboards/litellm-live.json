{
  "uid": "litellm-live",
  "title": "LiteLLM - Live",
  "description": "Live view from Prometheus. Counters reset when the proxy restarts - use the Cost dashboard (Postgres) for money.",
  "tags": ["litellm", "prometheus"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(litellm_remaining_team_budget_metric, team_alias)", "refId": "team" },
        "definition": "label_values(litellm_remaining_team_budget_metric, team_alias)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Spend in range",
      "description": "Sum of litellm_spend_metric over the selected time range.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(litellm_spend_metric_total{team_alias=~\"$team\"}[$__range]))", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 2, "type": "stat", "title": "Requests in range",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(litellm_proxy_total_requests_metric_total{team_alias=~\"$team\", route=~\".*/(chat/completions|completions|embeddings|responses|messages|images/generations|audio/(transcriptions|speech)|rerank|moderations)\"}[$__range]))", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 3, "type": "stat", "title": "Error rate in range",
      "description": "Failed / total proxy requests. Amber at 2%, red at 5% (the alert threshold).",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(litellm_proxy_failed_requests_metric_total{team_alias=~\"$team\", route=~\".*/(chat/completions|completions|embeddings|responses|messages|images/generations|audio/(transcriptions|speech)|rerank|moderations)\"}[$__range])) / sum(increase(litellm_proxy_total_requests_metric_total{team_alias=~\"$team\", route=~\".*/(chat/completions|completions|embeddings|responses|messages|images/generations|audio/(transcriptions|speech)|rerank|moderations)\"}[$__range]))", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 1, "noValue": "0%",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "#EAB839", "value": 0.02 }, { "color": "red", "value": 0.05 } ] }
        }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 4, "type": "stat", "title": "p95 latency in range",
      "description": "End-to-end request latency (proxy + provider). Alert fires above 30s.",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(litellm_request_total_latency_metric_bucket{team_alias=~\"$team\"}[$__range])))", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "#EAB839", "value": 15 }, { "color": "red", "value": 30 } ] }
        }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 5, "type": "timeseries", "title": "Spend rate by team ($ / min)",
      "description": "How fast each team is spending right now. This is a rate, so do not add points up - for totals use 'Spend in range' above or the Cost dashboard (exact, from Postgres). '(no team: admin/UI)' = calls made with the master key or the UI Playground's own session.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (team_alias) (label_replace(rate(litellm_spend_metric_total{team_alias=~\"$team\"}[$__rate_interval]), \"team_alias\", \"(no team: admin/UI)\", \"team_alias\", \"None|\")) * 60", "legendFormat": "{{team_alias}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "pointSize": 8, "showPoints": "never", "spanNulls": true, "axisSoftMin": 0, "axisLabel": "$ / min" }
        }, "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Tokens by model (tokens / min)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "(sum by (requested_model) (rate(litellm_total_tokens_metric_total{team_alias=~\"$team\", requested_model!=\"\"}[$__rate_interval])) or sum by (requested_model) (label_replace(rate(litellm_total_tokens_metric_total{team_alias=~\"$team\", requested_model=\"\"}[$__rate_interval]), \"requested_model\", \"$1\", \"model\", \"(.+)\"))) * 60", "legendFormat": "{{requested_model}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true, "axisLabel": "tokens / min" }
        }, "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Request rate by team (req / s)",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (team_alias) (label_replace(rate(litellm_proxy_total_requests_metric_total{team_alias=~\"$team\", route=~\".*/(chat/completions|completions|embeddings|responses|messages|images/generations|audio/(transcriptions|speech)|rerank|moderations)\"}[$__rate_interval]), \"team_alias\", \"(no team: admin/UI)\", \"team_alias\", \"None|\"))", "legendFormat": "{{team_alias}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        }, "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Errors by reason (req / s)",
      "description": "Failed requests grouped by exception class and HTTP status. 403 ModelAccessDenied = a key asked for a model its team may not use.",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (exception_class, exception_status) (rate(litellm_proxy_failed_requests_metric_total{team_alias=~\"$team\", route=~\".*/(chat/completions|completions|embeddings|responses|messages|images/generations|audio/(transcriptions|speech)|rerank|moderations)\"}[$__rate_interval]))", "legendFormat": "{{exception_status}} {{exception_class}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        }, "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Latency p95 by model group (s)",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, model_group) (rate(litellm_request_total_latency_metric_bucket{team_alias=~\"$team\", model_group!=\"\"}[$__rate_interval]))) >= 0", "legendFormat": "{{model_group}}" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "always", "pointSize": 6, "spanNulls": 120000,
                      "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 30 } ] }
        }, "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 10, "type": "bargauge", "title": "Budget used (% of team max)",
      "description": "Amber at 80% (alert), red at 95%. Requests are rejected at 100%.",
      "gridPos": { "x": 12, "y": 21, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "1 - (min by (team, team_alias) (litellm_remaining_team_budget_metric{team_alias=~\"$team\"}) / (max by (team, team_alias) (litellm_team_max_budget_metric{team_alias=~\"$team\"}) > 0))", "legendFormat": "{{team_alias}}", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "#EAB839", "value": 0.8 }, { "color": "red", "value": 0.95 } ] }
        }, "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "valueMode": "text", "namePlacement": "top", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 11, "type": "bargauge", "title": "Budget remaining ($)",
      "gridPos": { "x": 18, "y": 21, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "min by (team, team_alias) (litellm_remaining_team_budget_metric{team_alias=~\"$team\"})", "legendFormat": "{{team_alias}}", "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "min": 0, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "valueMode": "text", "namePlacement": "top", "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
