# secrets - never commit
.env
bootstrap/generated-keys.json
prometheus/secrets/
alertmanager/slack_webhook_url
certs/*.pem
certs/.chain.*/

# local caches
__pycache__/
*.pyc

# generated by bootstrap: scoped DB roles (contain passwords) and credentials
postgres/generated/
bootstrap/scope-credentials.json
bootstrap/langfuse-projects.json
bootstrap/test-users.json
alertmanager/slack/

# per machine: copy setup.example.yml (setup.<env>.yml files may be committed)
setup.yml
# generated from setup.yml
prometheus/prometheus.attach.yml
